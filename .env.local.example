# Copy this file to .env.local (already gitignored) and fill in real values.
# Supabase dashboard -> Project Settings -> API.
#
# Both of these are the PUBLIC/anon values — safe to ship to the browser,
# which is why they're prefixed NEXT_PUBLIC_. RLS policies (see
# supabase/migrations/0001_init.sql) are what actually keep one user's data
# away from another; these keys alone grant nothing.
#
# NEVER put the service_role key in a NEXT_PUBLIC_* var, in this file, or
# anywhere that ships to the browser. It bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
