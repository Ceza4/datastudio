# Copy this file to .env.local (already gitignored) and fill in real values.
# Supabase dashboard -> Project Settings -> API.
#
# Both of these are the PUBLIC/anon values — safe to ship to the browser,
# which is why they're prefixed NEXT_PUBLIC_. RLS policies (see
# supabase/migrations/0001_init.sql) are what actually keep one user's data
# away from another; these keys alone grant nothing.
#
# NEVER put the service_role key in a NEXT_PUBLIC_* var, in this file, or
# anywhere that ships to the browser. It bypasses RLS entirely.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── SERVER ONLY. NEVER prefixed NEXT_PUBLIC_. ────────────────────────────────
# The service role key bypasses every RLS policy in supabase/migrations — it is
# the one credential that makes the whole database readable. Next inlines every
# NEXT_PUBLIC_* variable into the browser bundle at build time, so the prefix is
# not a naming convention here, it is the difference between a secret and a
# published one.
#
# Needed only by the privileged server routes (account deletion, and the billing
# webhook when it lands). Everything else in the app runs as the signed-in user
# through RLS and does not want this key.
#
# Project Settings -> API -> service_role. Set it in the deployment environment
# (Vercel project settings), not in a file that lives next to the code.
SUPABASE_SERVICE_ROLE_KEY=

# ── PUBLIC. The address the pricing page's "Get in touch" button writes to. ──
# There is no payment provider yet, so upgrading is an email. This is a variable
# rather than a string in app/pricing/page.js because that string used to be
# hello@datastudio.app — an address invented while writing the page, belonging
# to nobody. A support address that bounces is worse than none at all: the
# person who clicks it believes they have asked for something, and then waits.
#
# Leave it EMPTY until a real mailbox exists. The paid tiers then read "Not on
# sale yet", which is accurate. Set it and the button appears.
NEXT_PUBLIC_CONTACT_EMAIL=
